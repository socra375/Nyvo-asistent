# ─────────────────────────────────────────────────────────────────────────────
# Nyvo · variables de entorno (SOLO servidor). Copia a .env para desarrollo local
# y configúralas en Vercel → Project → Settings → Environment Variables.
# Ningún valor real va en el repositorio. Ninguna llega al navegador.
# Si falta una variable, el conector aparece como «falta configurar».
# ─────────────────────────────────────────────────────────────────────────────

# ── Núcleo (obligatorias) ───────────────────────────────────────────────────
# Postgres de Neon (proyecto propio de Nyvo, NO el de AINova). Usa la cadena "pooled".
DATABASE_URL=
# Correo(s) que pueden entrar, separados por comas (cuenta de la empresa).
NYVO_OWNER_EMAIL=
# Clave AES-256 para cifrar tokens OAuth: 32 bytes en base64.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NYVO_ENC_KEY=
# URL pública de Nyvo (sin barra final), p. ej. https://nyvo-ainova.vercel.app
APP_URL=
# Secreto del disparador de trabajos en segundo plano (el mismo valor en GitHub → Secrets → CRON_SECRET).
CRON_SECRET=

# ── Gemini (texto, transcripción y voz) ─────────────────────────────────────
GEMINI_API_KEY=
# Opcional: modelo(s) de texto con llamadas a funciones (varios separados por coma). Sin valor se usa gemini-flash-lite-latest,
# el de cuota gratuita más generosa. Confírmalo en https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=
# Texto a voz. Confirma el id del modelo TTS y el nombre de la voz en
# https://ai.google.dev/gemini-api/docs/speech-generation (no se fijan por defecto a propósito).
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# Opcional: estilo de lectura (el tono se dirige con texto).
# GEMINI_TTS_STYLE=Lee en español neutro latinoamericano, con tono profesional y cercano, ritmo medio

# ── Voz de Nyvo ─────────────────────────────────────────────────────────────
# Sin VOICE_PROVIDER, Nyvo usa la voz del NAVEGADOR (elige sola una voz en español; sin claves, sin cuota) salvo que Gemini TTS
# esté completo. VOICE_PROVIDER = navegador | gemini | speechify | elevenlabs.
# VOICE_PROVIDER=navegador
# ElevenLabs (opcional)
# VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Por defecto eleven_flash_v2_5 (español, rápido, la mitad de créditos que eleven_multilingual_v2).
# ELEVENLABS_MODEL_ID=
# Si la voz del servidor falla (cuota, caída), Nyvo lee con la voz del navegador: no hace falta configurar nada.

# ── Rotación de motores de IA ───────────────────────────────────────────────
# Cada motor se activa con su CLAVE; el modelo es opcional y, sin él, se usa uno gratuito por defecto:
#   Gemini gemini-flash-lite-latest · Groq openai/gpt-oss-120b · OpenRouter openrouter/free · Cerebras llama-3.3-70b
# Si hay varios, Nyvo prueba en orden y pasa al siguiente en cuanto uno falla o tarda demasiado (se evita unos segundos al caído).
# LLM_PROVIDERS=gemini,groq,openrouter,cerebras
# Cada *_MODEL admite VARIOS modelos separados por coma: se prueban en ese orden y, si uno agota su cuota, pasa al siguiente
# (los límites gratuitos suelen ser por modelo). Ejemplo: GROQ_MODEL=modelo-1,modelo-2,modelo-3
# GROQ_MODEL=              (la misma GROQ_API_KEY de la escucha sirve; elige modelos con herramientas). Si Groq retira el modelo,
#                          Nyvo pide su lista y pasa solo a gpt-oss-120b/20b, qwen, llama-4 o moonshotai, el primero que siga disponible.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=
# Ahorro de cuota (Groq): tope aproximado de tokens de entrada por petición; se recortan los mensajes más antiguos (por defecto 7500).
# En los modelos gpt-oss de Groq se pide reasoning_effort «low».
# GROQ_MAX_INPUT_TOKENS=7500
# LLM_ATTEMPT_TIMEOUT_MS=10000
# Plazo total de una respuesta de chat (ms, por defecto 50000: debe quedar bajo los 60 s de Vercel).
# TURN_BUDGET_MS=50000
# El «pensar» oculto de Gemini también gasta cuota y suma segundos. En modelos Flash Nyvo pide lo mínimo que admita cada versión
# (thinkingBudget 0 → thinkingLevel minimal → low → sin ajuste, recordando el que funcione). Aquí puedes fijar un valor propio; si el
# modelo no admite ese valor, se reintenta una vez sin él.
# GEMINI_THINKING_BUDGET=0
# LLM_COOLDOWN_MS=60000

# ── Escucha (transcripción): Whisper de Groq ────────────────────────────────
# Si hay GROQ_API_KEY, Nyvo transcribe con Groq (sin necesitar Gemini para oír). Sin ella usa Gemini. Si hay las dos claves, cada
# una respalda a la otra cuando se queda sin cuota o se cae (salvo que fijes STT_PROVIDER).
GROQ_API_KEY=
# Opcionales: modelo (por defecto whisper-large-v3-turbo), idioma (por defecto es) y forzar proveedor (groq | gemini).
# GROQ_STT_MODEL=
# GROQ_STT_LANGUAGE=es
# STT_PROVIDER=

# ── Voz alternativa: Speechify (opcional) ───────────────────────────────────
# VOICE_PROVIDER=speechify
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=
# Para español hace falta un modelo multilingüe (por defecto: simba-multilingual).
# SPEECHIFY_MODEL=
# SPEECHIFY_API_URL=https://api.sws.speechify.com

# ── AINova System (clientes, cobros, chat con clientes) ─────────────────────
# API REST con clave del panel de AINova (/api/v1). Basta el origen; se exige HTTPS.
AINOVA_API_URL=https://ainova-system.vercel.app
# Clave propia de Nyvo (ain_ + 43 caracteres). Se crea en AINova → Configuración → Claves de acceso por API,
# con permiso «Lectura y escritura» y caducidad. Va solo aquí: nunca en el chat ni en el repositorio.
AINOVA_API_KEY=

# ── Notion (archivo de Nyvo) ────────────────────────────────────────────────
# Integración interna: https://www.notion.so/my-integrations
NOTION_TOKEN=
# Id o enlace de la página raíz «Nyvo», compartida con la integración.
NOTION_ROOT_PAGE_ID=

# ── Google (login y conectores; permisos por partes) ────────────────────────
# Cliente OAuth «Aplicación web». URL de retorno autorizada: <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Límites (opcionales; valores por defecto entre paréntesis) ──────────────
# TTS_MAX_CHARS=1500
# STT_MAX_BYTES=3000000
# SPECIALIST_DEADLINE_MS=40000
# SPECIALIST_MAX_CALLS=8
# JOBS_TICK_BUDGET_MS=45000

# ── Fases siguientes (aún no se usan) ───────────────────────────────────────
# GITHUB_TOKEN=          # fase 2: habilidades desde GitHub (más límite de peticiones)
# S3_ENDPOINT=           # fase 2: PDFs de facturas y archivos
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
